{
  "name": "efabrica/translation-automatization",
  "type": "library",
  "description": "Translation automatization",
  "keywords": ["PHP", "Translation", "Automatization"],
  "license": "MIT",
  "config": {
    "audit": {
      "ignore": [
        "PKSA-z3gr-8qht-p93v",
        "PKSA-tcfz-w4fm-hhk9",
        "PKSA-y2cr-5h3j-g3ys",
        "PKSA-2kqm-ps5x-s4f5"
      ]
    }
  },
  "require": {
    "ext-json": "*",
    "php": ">=7.4",
    "nette/neon": "^2.4 | ^3.3",
    "nette/utils": "^2.5 | ^3.0",
    "symfony/console": "^4.0 | ^5.0",
    "symfony/finder": "^4.0 | ^5.0 | ^6.0",
    "nikic/php-parser": "^5.3",
    "guzzlehttp/guzzle": "^6.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^7.1",
    "squizlabs/php_codesniffer": "^3.2",
    "google/cloud-translate": "^1.12",
    "google/apiclient": "^2.12.1"
  },
  "autoload": {
    "classmap": ["src/"]
  },
  "autoload-dev": {
    "classmap": ["tests/"]
  },
  "bin": ["bin/translation-automatization"]
}
